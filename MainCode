-- ==========================================
-- KEY SYSTEM UI (Runs first)
-- ==========================================
local function LoadKeySystem()
    local Library = loadstring(game:HttpGet(repo .. 'Library.lua'))()

    local KeyWindow = Library:CreateWindow({
        Title = 'Diamond Hub | Authentication',
        Center = true,
        AutoShow = true,
        TabPadding = 8,
        MenuFadeTime = 0.2
    })

    local KeyTab = KeyWindow:AddTab('Login')
    local KeyGroup = KeyTab:AddLeftGroupbox('Key Verification')

    local currentKey = ""

    KeyGroup:AddInput('KeyInput', {
        Default = '',
        Numeric = false,
        Finished = false,
        Text = 'Enter Key',
        Placeholder = 'Type or paste key here...',
        Callback = function(Value)
            currentKey = Value
        end
    })

    KeyGroup:AddButton('Verify Key', function()
        if currentKey == correctKey then
            Library:Notify('Access Granted! Loading Hub...', 2)
            task.wait(1.5)
            Library:Unload() -- Destroys the key UI smoothly
            task.wait(0.5)
            LoadMainHub() -- Boot up the actual hub
        else
            Library:Notify('Incorrect Key! Join the Discord to get it.', 3)
        end
    end)

    KeyGroup:AddButton('Get Key (Copy Discord Link)', function()
        -- Uses setclipboard to automatically copy your Discord invite
        if setclipboard then
            setclipboard("https://discord.gg/p6cyRX7MQv")
            Library:Notify('Discord link copied to clipboard!', 3)
        else
            Library:Notify('Your executor does not support auto-copying.', 3)
        end
    end)
    
    Library:SetWatermarkVisibility(true)
    Library:SetWatermark('Diamond Hub | Key Check')
end

-- Start the script by loading the key system
LoadKeySystem()
