-- Helper: Hybrid R6 & R15 Hitbox Part Selector
local function getUnifiedTargetPart(character)
    if not character then return nil end
    local selection = _G.CombatSettings.HitPart
    
    local boneMap = {
        ["Head"] = {"Head"},
        ["Torso"] = {"UpperTorso", "Torso", "HumanoidRootPart"},
        ["Left Arm"] = {"LeftUpperArm", "LeftArm", "Left Arm"},
        ["Right Arm"] = {"RightUpperArm", "RightArm", "Right Arm"},
        ["Left Leg"] = {"LeftUpperLeg", "LeftLeg", "Left Leg"},
        ["Right Leg"] = {"RightUpperLeg", "RightLeg", "Right Leg"}
    }
    
    local lookFor = boneMap[selection] or {"Head"}
    for _, partName in ipairs(lookFor) do
        local part = character:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            return part
        end
    end
    return character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
end

-- Helper: Check if target is behind a wall
local function isBehindWall(targetPart)
    if not _G.CombatSettings.WallCheck or not targetPart then return false end
    local castParts = Camera:GetPartsObscuringTarget({Camera.CFrame.Position, targetPart.Position}, {player.Character, targetPart.Parent})
    return #castParts > 0
end

-- Helper: Screen Space Selection Filter
local function getClosestPlayer()
    local mousePos = UserInputService:GetMouseLocation()
    local closest, shortest = nil, math.huge
    
    if CurrentTarget and CurrentTarget:FindFirstChild("Humanoid") and CurrentTarget.Humanoid.Health > 0 then
        local trackingPart = getUnifiedTargetPart(CurrentTarget)
        if trackingPart then
            local vector, onScreen = Camera:WorldToViewportPoint(trackingPart.Position)
            if onScreen then
                local dist = (Vector2.new(vector.X, vector.Y) - mousePos).Magnitude
                if dist < _G.CombatSettings.SwapThreshold and not isBehindWall(trackingPart) then
                    return CurrentTarget
                end
            end
        end
    end

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= player and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            local trackingPart = getUnifiedTargetPart(v.Character)
            if trackingPart and not isBehindWall(trackingPart) then
                local vector, onScreen = Camera:WorldToViewportPoint(trackingPart.Position)
                if onScreen then
                    local dist = (Vector2.new(vector.X, vector.Y) - mousePos).Magnitude
                    if dist < shortest then 
                        closest = v.Character 
                        shortest = dist 
                    end
                end
            end
        end
    end
    return closest
end

local function clearVisualCache(plr)
    if VisualCache[plr] then
        for _, object in pairs(VisualCache[plr]) do
            pcall(function() object:Remove() end)
        end
        VisualCache[plr] = nil
    end
end

local function endFlight()
    if FlyVelocity then FlyVelocity:Destroy() FlyVelocity = nil end
    if FlyGyro then FlyGyro:Destroy() FlyGyro = nil end
    local char = player.Character
    local humanoid = char and char:FindFirstChild("Humanoid")
    if humanoid then humanoid.PlatformStand = false end
end

local function getServerPlayerNames()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then table.insert(list, p.Name) end
    end
    if #list == 0 then table.insert(list, "No other players") end
    return list
end

-- ==========================================
-- MAIN RENDERING & MOVEMENT LOOP
-- ==========================================
RunService.RenderStepped:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local humanoid = char and char:FindFirstChild("Humanoid")
    
    -- Sync Canvas FOV Properties
    FOVCircle.Visible = (_G.ESPConfig.FOV.Enabled == true)
    FOVCircle.Radius = _G.ESPConfig.FOV.Size
    FOVCircle.Color = _G.ESPConfig.Colors.FOV
    FOVCircle.Position = mousePos

    -- Aimbot Calculations
    if _G.CombatSettings.Aimbot.active or _G.CombatSettings.AimAssist.active then
        CurrentTarget = getClosestPlayer()
        local targetPart = getUnifiedTargetPart(CurrentTarget)
        
        if CurrentTarget and targetPart then
            local targetVelocity = (CurrentTarget:FindFirstChild("HumanoidRootPart") or CurrentTarget:FindFirstChild("Torso") or CurrentTarget.PrimaryPart).Velocity
            local predictedPos = targetPart.Position + (targetVelocity * (_G.CombatSettings.Prediction / 1000))
            
            local screenPos, onScreen = Camera:WorldToViewportPoint(predictedPos)
            local target2D = Vector2.new(screenPos.X, screenPos.Y)
            local distFromMouse = (target2D - mousePos).Magnitude
            
            if not _G.ESPConfig.FOV.Enabled or (distFromMouse <= _G.ESPConfig.FOV.Size) then
                local smoothValue = math.clamp(_G.CombatSettings.Smoothness, 1, 1000)
                local speedFactor = _G.CombatSettings.Aimbot.active and (1 / smoothValue) or (0.25 / smoothValue)
                
                local targetX = mousePos.X + ((target2D.X - mousePos.X) * speedFactor)
                local targetY = mousePos.Y + ((target2D.Y - mousePos.Y) * speedFactor)
                
                if mousemoveabs then mousemoveabs(targetX, targetY)
                elseif Input and Input.MouseMoveabs then Input.MouseMoveabs(targetX, targetY)
                elseif mousemoverel then mousemoverel((target2D.X - mousePos.X) * speedFactor, (target2D.Y - mousePos.Y) * speedFactor) end
            end
        end
    else
        CurrentTarget = nil
    end
    
    -- Dynamic ESP Matrix Processing
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= player then
            if _G.ESPConfig.Enabled and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
                local tChar = v.Character
                local tHrp = tChar:FindFirstChild("HumanoidRootPart") or tChar:FindFirstChild("Torso")
                local tHead = tChar:FindFirstChild("Head")
                
                if tHead and tHrp then
                    local hrpPos, hrpOnScreen = Camera:WorldToViewportPoint(tHrp.Position)
                    local headPos, _ = Camera:WorldToViewportPoint(tHead.Position + Vector3.new(0, 1.5, 0))
                    local legPos, _ = Camera:WorldToViewportPoint(tHrp.Position - Vector3.new(0, 3, 0))
                    
                    if hrpOnScreen then
                        if not VisualCache[v] then
                            VisualCache[v] = {
                                Box = Drawing.new("Square"),
                                Tracer = Drawing.new("Line"),
                                Name = Drawing.new("Text"),
                                HealthBar = Drawing.new("Square")
                            }
                        end
                        
                        local cache = VisualCache[v]
                        local boxHeight = math.abs(headPos.Y - legPos.Y)
                        local boxWidth = boxHeight * 0.6
                        
                        cache.Box.Visible = _G.ESPConfig.Box
                        cache.Box.Size = Vector2.new(boxWidth, boxHeight)
                        cache.Box.Position = Vector2.new(hrpPos.X - boxWidth / 2, hrpPos.Y - boxHeight / 2)
                        cache.Box.Color = _G.ESPConfig.Colors.Box
                        cache.Box.Thickness = 1
                        
                        cache.Tracer.Visible = _G.ESPConfig.Tracers
                        cache.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        cache.Tracer.To = Vector2.new(hrpPos.X, hrpPos.Y)
                        cache.Tracer.Color = _G.ESPConfig.Colors.Tracers
                        cache.Tracer.Thickness = 1
                        
                        cache.Name.Visible = _G.ESPConfig.Names
                        cache.Name.Text = v.DisplayName or v.Name
                        cache.Name.Position = Vector2.new(hrpPos.X, headPos.Y - 15)
                        cache.Name.Color = _G.ESPConfig.Colors.Names
                        cache.Name.Center = true
                        cache.Name.Size = 14
                        
                        cache.HealthBar.Visible = _G.ESPConfig.HealthBar
                        local healthPercent = tChar.Humanoid.Health / tChar.Humanoid.MaxHealth
                        cache.HealthBar.Size = Vector2.new(2, boxHeight * healthPercent)
                        cache.HealthBar.Position = Vector2.new((hrpPos.X - boxWidth / 2) - 6, hrpPos.Y - boxHeight / 2 + (boxHeight * (1 - healthPercent)))
                        cache.HealthBar.Color = _G.ESPConfig.Colors.HealthBar
                        cache.HealthBar.Filled = true
                    else clearVisualCache(v) end
                else clearVisualCache(v) end
            else clearVisualCache(v) end
        end
    end

    -- Smooth Body Physics Fly System
    if MovementVars.Fly and hrp and humanoid then
        humanoid.PlatformStand = true
        
        if not FlyVelocity then
            FlyVelocity = Instance.new("BodyVelocity")
            FlyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            FlyVelocity.Velocity = Vector3.new(0, 0, 0)
            FlyVelocity.Parent = hrp
        end
        
        if not FlyGyro then
            FlyGyro = Instance.new("BodyGyro")
            FlyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            FlyGyro.CFrame = hrp.CFrame
            FlyGyro.Parent = hrp
        end
        
        local flyDir = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then flyDir = flyDir + Vector3.new(0, 0, -1) end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then flyDir = flyDir + Vector3.new(0, 0, 1) end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then flyDir = flyDir + Vector3.new(-1, 0, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then flyDir = flyDir + Vector3.new(1, 0, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then flyDir = flyDir + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then flyDir = flyDir + Vector3.new(0, -1, 0) end
        
        FlyVelocity.Velocity = hrp.CFrame:VectorToWorldSpace(flyDir * MovementVars.FlySpeed)
        FlyGyro.CFrame = hrp.CFrame
    else
        if FlyVelocity or FlyGyro then endFlight() end
    end

    -- WalkSpeed and JumpPower Loop Enforcer
    if not MovementVars.Fly and humanoid then
        humanoid.WalkSpeed = MovementVars.Speed
        if humanoid.UseJumpPower then humanoid.JumpPower = MovementVars.Jump else humanoid.JumpHeight = MovementVars.Jump / 3.7 end
    end

    if MiscSettings.InstaPrompt then
        for _, p in pairs(workspace:GetDescendants()) do if p:IsA("ProximityPrompt") then p.HoldDuration = 0 end end
    end
end)

Players.PlayerRemoving:Connect(clearVisualCache)

-- ==========================================
-- SUBSYSTEM ENFORCERS (Heartbeat Thread)
-- ==========================================
RunService.Heartbeat:Connect(function()
    local char = player.Character
    if MiscSettings.InfStamina then
        for _, o in pairs(player:GetDescendants()) do if (o:IsA("NumberValue") or o:IsA("IntValue")) and (string.find(string.lower(o.Name), "stamina") or string.find(string.lower(o.Name), "stam")) then o.Value = 999999 end end
        if char then for _, o in pairs(char:GetDescendants()) do if (o:IsA("NumberValue") or o:IsA("IntValue")) and (string.find(string.lower(o.Name), "stamina") or string.find(string.lower(o.Name), "stam")) then o.Value = 999999 end end end
    end

    if char then
        for _, p in pairs(char:GetDescendants()) do
            if p:IsA("BasePart") or p:IsA("Decal") then
                if MiscSettings.Invisible then
                    if not TransparencyStorage[p] then TransparencyStorage[p] = p.Transparency end
                    p.Transparency = 1
                else
                    if TransparencyStorage[p] then
                        p.Transparency = TransparencyStorage[p]
                        TransparencyStorage[p] = nil
                    end
                end
            end
        end
    else
        table.clear(TransparencyStorage)
    end
end)

