-- ==========================================
-- AUTHENTICATION KEY SYSTEM
-- ==========================================
local function LoadKeySystem()
    local Library = loadstring(game:HttpGet(repo .. 'Library.lua'))()
    local KeyWindow = Library:CreateWindow({ Title = 'Diamond Universal | Authentication', Center = true, AutoShow = true })

    local KeyTab = KeyWindow:AddTab('Login')
    local KeyGroup = KeyTab:AddLeftGroupbox('Key Verification')
    local currentKey = ""

    KeyGroup:AddInput('KeyInput', {
        Default = '', Numeric = false, Finished = false, Text = 'Enter Key', Placeholder = 'Type or paste key here...',
        Callback = function(Value) currentKey = Value end
    })

    KeyGroup:AddButton('Verify Key', function()
        if currentKey == correctKey then
            Library:Notify('Access Granted! Loading Hub...', 2)
            task.wait(1.5)
            Library:Unload()
            task.wait(0.5)
            LoadMainHub()
        else
            Library:Notify('Incorrect Key Verification Failed!', 3)
        end
    end)
    
    Library:SetWatermarkVisibility(true)
    Library:SetWatermark('Diamond Hub | Key Check')
end

LoadKeySystem()
